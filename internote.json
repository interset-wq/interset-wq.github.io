an>(<span class=\"pl-s1\">n</span>: <span class=\"pl-smi\">int</span>) <span class=\"pl-c1\">-&gt;</span> <span class=\"pl-smi\">int</span>:\n    <span class=\"pl-k\">return</span> <span class=\"pl-s1\">n</span> <span class=\"pl-k\">if</span> <span class=\"pl-s1\">n</span> <span class=\"pl-c1\">&lt;</span> <span class=\"pl-c1\">2</span> <span class=\"pl-k\">else</span> <span class=\"pl-en\">fib</span>(<span class=\"pl-s1\">n</span><span class=\"pl-c1\">-</span><span class=\"pl-c1\">1</span>) <span class=\"pl-c1\">+</span> <span class=\"pl-en\">fib</span>(<span class=\"pl-s1\">n</span><span class=\"pl-c1\">-</span><span class=\"pl-c1\">2</span>)</pre></div>\n<div class=\"highlight highlight-source-js\"><pre class=\"notranslate\"><span class=\"pl-k\">const</span> <span class=\"pl-en\">greet</span> <span class=\"pl-c1\">=</span> <span class=\"pl-kos\">(</span><span class=\"pl-s1\">name</span><span class=\"pl-kos\">)</span> <span class=\"pl-c1\">=&gt;</span> <span class=\"pl-s\">`hello <span class=\"pl-s1\"><span class=\"pl-kos\">${</span><span class=\"pl-s1\">name</span><span class=\"pl-kos\">}</span></span>`</span><span class=\"pl-kos\">;</span></pre></div>\n<p>行内代码 <code class=\"notranslate\">printf(\"hi\")</code>。</p>"}}